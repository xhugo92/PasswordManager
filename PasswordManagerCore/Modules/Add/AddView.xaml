<UserControl x:Class="PasswordManagerCore.Modules.AddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:PasswordManagerCore.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
>

  
<StackPanel Background="White">

        <TextBlock
            Text="Create new password"  
            FontWeight="SemiBold"
            Margin="5, 0, 2, 5"
        />

        <Border
            BorderBrush="#3399FF"
            BorderThickness="2"
            CornerRadius="8"
            Padding="5"
            Margin="0,0,0 10"
        >
            <StackPanel Orientation="Vertical">

                <StackPanel Orientation="Vertical">
                    <TextBlock 
                        Text="Source: "                    
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        TextWrapping="Wrap" 
                        Margin="5"
                    />

                    <TextBox
                        Text="{Binding SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="5,0,0,5"
                    />

                    <TextBlock 
                        Text="User: "                   
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        TextWrapping="Wrap" 
                        Margin="5"
                    />

                    <TextBox
                            Text="{Binding UsernameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="5,0,0,5"          
                        />

                    <TextBlock 
                            Text="Password: "                       
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            TextWrapping="Wrap" 
                            Margin="5"
                        />

                    <TextBox
                            Text="{Binding PasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="5,0,0,5"            
                        >
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="TextChanged">
                                <i:InvokeCommandAction Command="{Binding ChangePasswordCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </StackPanel>

                <StackPanel 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                >
                    <Button 
                        Content="Create" 
                        Command="{Binding GeneratePasswordCommand}" 
                        Margin="5"
                        Style="{StaticResource ButtonStyle}"/>

                    <Button 
                        Content="Clear" 
                        Command="{Binding ClearFieldsCommand}" 
                        Margin="5"
                        Style="{StaticResource ButtonStyle}"/>

                    <Button 
                        Content="Save" 
                        Command="{Binding AddToDatabaseCommand}" 
                        Margin="5"
                        Style="{StaticResource ButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Text="Password settings"  
            FontWeight="SemiBold"
            Margin="5, 0, 2, 5"
        />

        <Border
            BorderBrush="#3399FF"
            BorderThickness="2"
            CornerRadius="8"
            Padding="5"
            Margin="0,0,0 10"
        >
            <StackPanel Orientation="Vertical">
                <StackPanel 
                    Orientation="Horizontal"
                    Margin="0,0,0, 5"
                >
                    <TextBlock 
                        Text="Size: " 
                        TextWrapping="Wrap" 
                        HorizontalAlignment="Left" 
                    />
                
                    <TextBox 
                        Width="30" 
                        MaxLength="3"
                        ToolTip="Apenas números positivos até 999"
                        Text="{Binding LengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        PreviewTextInput="PreviewTextInputPasswordSize"                    
                    />
                </StackPanel>

                <CheckBox 
                    IsChecked="{Binding NumberIsChecked, Mode=TwoWay}" 
                    Content="Numbers (0-9)"
                    Margin="0, 0, 0, 5"/>
                
                <CheckBox 
                    IsChecked="{Binding UpperIsChecked, Mode=TwoWay}" 
                    Content="Upper case (A-Z)"
                    Margin="0, 0, 0, 5"/>
                
                <CheckBox 
                    IsChecked="{Binding LowerIsChecked, Mode=TwoWay}" 
                    Content="Lower case (a-z)"
                    Margin="0, 0, 0, 5"/>
                
                <CheckBox 
                    IsChecked="{Binding SpecialIsChecked, Mode=TwoWay}" 
                    Content="Special characters (@*!#$%)"
                    Margin="0, 0, 0, 5"/>                

            </StackPanel>
        </Border>
    </StackPanel>    
</UserControl>
